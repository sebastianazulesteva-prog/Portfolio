# macOS Finder metadata. These were TRACKED and deployed to the live site —
# and they are why `git status` showed a modified .DS_Store on every machine
# that had ever opened the folder in Finder. Untracked 2026-08-30.
.DS_Store
**/.DS_Store

Sebastian_Esteva_Resume.pdf

# /vr audio — the ambience + UI cue clips stay local. The scene ships with its
# audio kill switch hard-off (vr/index.html), so nothing on the live site
# looks for these. Drop the ignore when the sound design is finished and the
# switch is turned back on.
vr/assets/*.mp3
vr/assets/*.ogg
vr-audio/

# /vr dev-only harnesses — none are referenced by the shipped scene
# (VR_AI_BUILD_GUIDE.md §5), so they stay out of the public site. One glob
# rather than a list of names: this was `vr/_dev-*.js` plus `_dev-preview.html`,
# which meant the next harness anyone added (_dev-reader.html) was NOT covered
# and would have shipped. Delete these lines if you decide to version them.
vr/_dev-*

# Local dev tooling: a cloudflared binary and the self-signed cert (private key
# included) that .tools/vr-phone.sh generates for phone testing. Never publish.
.tools/
.Rhistory

# /vr SHARP portrait — the baked gaussian splats. 15 MB of regenerable binary
# does not belong in the repo before anyone has decided to ship option B; the
# 240 KB relief map (option A's whole payload) IS committed. Regenerate with
# vr/tools/sharp/ — see VR_SHARP_PORTRAIT.md. Drop these two lines if the
# splat portrait ever ships.
vr/assets/*.splat
